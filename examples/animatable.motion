# Motioner MDF: animatable content properties (D-0028).
#
# Every shape property is a channel: width, height, radius, fill, stroke,
# stroke_width and text size/color interpolate between keys. The golden still
# is frame 45 (0.75 s).
comp(name="Animatable", width=960, height=540, fps=60, duration=2, background="#0B0B12")

card = rect(300, 300, 24, fill="#FF5A6E")
card.id("card")
card.pos = (480, 270)
card.opacity = 0.92
card.key("width", 0, 120)
card.key("width", 1, 420, ease="cubic_in_out")
card.key("height", 0, 120)
card.key("height", 1, 300, ease="cubic_in_out")
card.key("radius", 0, 12)
card.key("radius", 1, 120, ease="quad_out")
card.key("fill", 0, "#FF5A6E")
card.key("fill", 1, "#3FD0C9", ease="cubic_in_out")

ring = circle(160, fill=None, stroke="#3FD0C9", stroke_width=2)
ring.id("ring")
ring.pos = (480, 270)
ring.key("stroke_width", 0, 2)
ring.key("stroke_width", 1, 18, ease="quad_in_out")
ring.key("stroke", 0, "#3FD0C9")
ring.key("stroke", 1, "#FF5A6E", ease="cubic_in_out")

title = text("MOTIONER", size=48, color="#FFFFFF", align="center")
title.id("title")
title.pos = (480, 470)
title.key("size", 0, 32)
title.key("size", 1, 72, ease="back_out")
title.key("color", 0, "#FFFFFF")
title.key("color", 1, "#FFE66D", ease="quad_in_out")
