comp(name="Fixture", width=1000, height=600, fps=60, duration=4.0, background="#101418")
a = text("A", "Inter", 48, "#FFFFFF", "center")
a.pos = (300, 200)
b = text("B", "Inter", 48, "#FFFFFF", "center")
b.pos = (500, 200)
c = text("C", "Inter", 48, "#FFFFFF", "center")
c.pos = (700, 200)
a.key("opacity", 0.0, 0.0)
a.key("opacity", 0.6, 1.0, ease="quad_out")
b.key("opacity", 0.0, 0.0)
b.key("opacity", 0.6, 1.0, ease="quad_out")
c.key("opacity", 0.0, 0.0)
c.key("opacity", 0.6, 1.0, ease="quad_out")
