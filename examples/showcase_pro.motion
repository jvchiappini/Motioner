# mdf: 0.1
#
# SHOWCASE PRO: a 24 s, 1080p60 piece that exercises every MDF feature of
# prompt 10 in one composition: animated colour palettes, self-drawing line
# art, shifting gradients, glass cards with shadows, a masked headline, kinetic
# per-character type in Inter, a cover-fit image, blend-mode light leaks,
# custom bezier timing, stagger/wiggle and motion blur.
#
# Render with:
#   motioner render examples/showcase_pro.motion --out out/showcase_pro.mp4
#
# Scenes: 0-4 s brand, 4-8 s colour, 8-12 s glass and image, 12-16 s masks,
# 16-20 s motion, 20-24 s outro. Each scene is a group centred on the canvas
# and cross-faded by its own opacity keys, so cuts never pop.

comp(name="Showcase Pro", width=1920, height=1080, fps=60, duration=24, background="#05070D", motion_blur=True, shutter=180, samples=8)

INK = "#F4F7FF"
MUTED = "#93A0B8"
CAPTION = "#C9D4E8"
DIM = "#141A2A"
BLUE = "#5B8CFF"
VIOLET = "#9B7BFF"
CORAL = "#FF5A6E"
AMBER = "#FFB547"
MINT = "#3FD9A4"
CYAN = "#3DE0E8"
PINK = "#FF6BD6"
PALETTE = [BLUE, VIOLET, CORAL, AMBER, MINT, CYAN, PINK]

PI = 3.141592653589793


def radians(degrees):
    return degrees * PI / 180


def pop(node, t, duration):
    node.key("scale", t, 0)
    node.key("scale", t + duration, 1, ease="back_out")


def fade_in(node, t, duration):
    node.key("opacity", t, 0)
    node.key("opacity", t + duration, 1, ease="quad_out")


def fade_out(node, t, duration):
    node.key("opacity", t, 1)
    node.key("opacity", t + duration, 0, ease="quad_in")


def rise(node, x, y, t, distance, duration):
    node.key("pos", t, (x, y + distance))
    node.key("pos", t + duration, (x, y), ease="cubic_out")


def scene(t_in, t_out):
    holder = group()
    holder.pos = (960, 540)
    holder.opacity = 0
    holder.key("opacity", 0, 0)
    holder.key("opacity", t_in, 0)
    holder.key("opacity", t_in + 0.04, 1)
    holder.key("opacity", t_out, 1)
    holder.key("opacity", t_out + 0.35, 0, ease="quad_in")
    return holder


def add_capsule(parent, colour, height, alpha):
    capsule = rect(1560, height, radius=height / 2, fill=linear_gradient(start= (-780, 0), end= (780, 0), stops= [(0, "#00000000"), (0.5, colour + alpha), (1, "#00000000")]))
    parent.add(capsule)


def label(content, size, color, x, y):
    node = text(content, font="Inter", size=size, weight=600, color=color, align="center")
    node.pos = (x, y)
    return node


# ---- persistent background -------------------------------------------------

# The gradient's middle stop is an animatable colour channel: the whole room
# changes temperature three times over the piece.
bg = rect(1920, 1080, fill=linear_gradient(start= (0, -540), end= (0, 540), stops= [(0, "#05070D"), (0.45, "#0D1530"), (1, "#05070D")]))
bg.pos = (960, 540)
bg.key("fill_stop1_color", 0, "#0D1530")
bg.key("fill_stop1_color", 6, "#2A1150", ease=bezier(0.45, 0, 0.25, 1))
bg.key("fill_stop1_color", 12, "#083A3A", ease=bezier(0.45, 0, 0.25, 1))
bg.key("fill_stop1_color", 18, "#3A1020", ease=bezier(0.45, 0, 0.25, 1))
bg.key("fill_stop1_color", 24, "#0D1530", ease=bezier(0.45, 0, 0.25, 1))

# Three faint colour orbs drift under everything. Their opacity is keyed so
# they support the brand and colour scenes, step back behind the glass and
# disappear for the mask scene, instead of tinting every frame.
for i in range(3):
    orb = circle(260, fill=radial_gradient(center= (0, 0), radius=260, stops= [(0, PALETTE[i] + "20"), (0.5, PALETTE[(i + 3) % 7] + "08"), (1, "#00000000")]))
    orb.blend = "add"
    x0 = 220 + i * 740
    y0 = 200 + (i % 2) * 600
    orb.pos = (x0, y0)
    orb.key("pos", 0, (x0, y0))
    orb.key("pos", 12, (x0 + 180 - i * 90, 1080 - y0), ease="sine_in_out")
    orb.key("pos", 24, (x0, y0), ease="sine_in_out")
    orb.key("scale", 0, 0.8)
    orb.key("scale", 12, 1, ease="sine_in_out")
    orb.key("scale", 24, 0.8, ease="sine_in_out")
    peak = 0.8 - i * 0.1
    orb.key("opacity", 0, peak)
    orb.key("opacity", 4, peak)
    orb.key("opacity", 8, peak * 0.4, ease="sine_in_out")
    orb.key("opacity", 11.8, peak * 0.4)
    orb.key("opacity", 12.3, 0, ease="quad_in")
    orb.key("opacity", 16, 0)
    orb.key("opacity", 16.6, peak * 0.8, ease="quad_out")
    orb.key("opacity", 22.4, peak * 0.8)
    orb.key("opacity", 24, 0, ease="quad_in")

# Blend-mode light leaks sweep across the piece. Each leak is a faint wide
# capsule plus a brighter core, so its long edges fall off instead of ending on
# a hard line; the linear gradient already fades both ends to transparent.
for i in range(3):
    colour = PALETTE[(i * 2) % 7]
    leak_group = group()
    leak_group.blend = "screen"
    leak_group.rotation = 18 + i * 7
    leak_group.pos = (-900 + i * 120, 180 + i * 250)
    leak_group.key("pos", 0, (-900 + i * 120, 180 + i * 250))
    leak_group.key("pos", 12, (2820 - i * 120, 700 - i * 180), ease="sine_in_out")
    leak_group.key("pos", 24, (-900 + i * 120, 180 + i * 250), ease="sine_in_out")
    leak_group.key("opacity", 0, 0)
    leak_group.key("opacity", 1.5 + i * 0.2, 0.8, ease="sine_in_out")
    leak_group.key("opacity", 22.5, 0.8)
    leak_group.key("opacity", 24, 0, ease="quad_in")
    add_capsule(leak_group, colour, 170, "14")
    add_capsule(leak_group, colour, 86, "44")

# ---- scene 1: brand (0-4 s) ------------------------------------------------

s1 = scene(0, 3.7)
s1.key("opacity", 0, 1)

# A monogram drawn as two trimmed paths: line art that writes itself. Both
# halves share the same origin and apex, so the join is exact and the shape
# reads as one clean M (matching the closing mark).
mark_left = path([(-170, 140), (-170, -140), (0, 20)], closed=False, fill=None, stroke=INK, stroke_width=16, cap="round", join="round")
mark_left.pos = (0, -150)
mark_left.key("trim_end", 0.25, 0)
mark_left.key("trim_end", 1.35, 1, ease=bezier(0.65, 0, 0.25, 1))
s1.add(mark_left)

mark_right = path([(0, 20), (170, -140), (170, 140)], closed=False, fill=None, stroke=BLUE, stroke_width=16, cap="round", join="round")
mark_right.pos = (0, -150)
mark_right.key("trim_end", 0.45, 0)
mark_right.key("trim_end", 1.55, 1, ease=bezier(0.65, 0, 0.25, 1))
s1.add(mark_right)

# A star and a wide halo orbit the mark: polygon fills, trim and dash.
orbit = group()
orbit.pos = (0, -150)
orbit.key("rotation", 0, 0)
orbit.key("rotation", 4, 90, ease="sine_in_out")
star_a = star(5, 18, 42, fill=AMBER, stroke="#FFE0A3", stroke_width=3)
star_a.pos = (300, -250)
star_a.key("rotation", 0, 0)
star_a.key("rotation", 4, 40, ease="sine_in_out")
s1.add(star_a)
arc_a = arc(235, -168, -12, fill=None, stroke=CYAN, stroke_width=7, cap="round")
arc_a.key("trim_end", 0.6, 0)
arc_a.key("trim_end", 2, 1, ease="cubic_in_out")
orbit.add(arc_a)
s1.add(orbit)

# Kinetic typography: one text node, per-character stagger in a real font.
word = text("MOTIONER", font="Inter", size=190, weight=700, color=INK, align="center", tracking=0.04)
word.pos = (0, 170)
word.animate_chars("opacity", 0, 1, 0.75, 0.08, 0.32, ease="cubic_out")
word.animate_chars("offset", (0, 70), (0, 0), 0.75, 0.08, 0.45, ease="cubic_out")
s1.add(word)

kicker = label("MOTION DESIGN, WRITTEN AS CODE", 30, CAPTION, 0, 300)
fade_in(kicker, 1.7, 0.6)
s1.add(kicker)

rule = rect(340, 4, radius=2, fill=BLUE)
rule.pos = (0, 268)
rule.key("scale", 1.4, (0, 1))
rule.key("scale", 2.2, (1, 1), ease="cubic_in_out")
s1.add(rule)

# ---- scene 2: colour (4-8 s) -----------------------------------------------

s2 = scene(4.1, 7.7)

heading2 = label("Colour is a channel", 84, INK, 0, -330)
rise(heading2, 0, -330, 4.2, 40, 0.6)
s2.add(heading2)
eyebrow2 = label("PALETTE / GRADIENT / BLEND", 28, CYAN, 0, -405)
fade_in(eyebrow2, 4.2, 0.4)
s2.add(eyebrow2)

bars = []
for i in range(7):
    bar = rect(74, 250, radius=18, fill=PALETTE[i])
    x = -540 + i * 180
    bar.pos = (x, 80)
    bars = bars + [bar]
    s2.add(bar)
    # The palette itself is animated: each bar cross-fades to its opposite
    # hue and back while the sheen travels across.
    bar.key("fill", 4.6, PALETTE[i])
    bar.key("fill", 5.9, PALETTE[(i + 3) % 7], ease="sine_in_out")
    bar.key("fill", 7.4, PALETTE[i], ease="sine_in_out")
    tag = label(str(i + 1), 28, "#05070D", x, 235)
    fade_in(tag, 4.4 + i * 0.05, 0.3)
    s2.add(tag)

stagger(bars, "height", [(250, 430)], 4.35, 0.07, 0.7, ease="back_out")
stagger(bars, "radius", [(18, 40)], 4.35, 0.07, 0.7, ease="back_out")

sheen = circle(170, fill=radial_gradient(center= (0, 0), radius=170, stops= [(0, "#FFFFFFCC"), (0.5, VIOLET + "66"), (1, "#00000000")]))
sheen.pos = (-430, 30)
sheen.key("pos.x", 4.8, -430)
sheen.key("pos.x", 7.2, 430, ease="sine_in_out")
sheen.key("fill_stop1_offset", 4.8, 0.35)
sheen.key("fill_stop1_offset", 7.2, 0.75, ease="quad_in_out")
s2.add(sheen)

caption2 = label("stops animate; light modes add", 30, CAPTION, 0, 430)
fade_in(caption2, 5, 0.5)
s2.add(caption2)

# ---- scene 3: glass and image (8-12 s) -------------------------------------

s3 = scene(8, 11.7)

heading3 = label("Glass, depth and a real image", 68, INK, 0, -380)
rise(heading3, 0, -380, 8.1, 36, 0.6)
s3.add(heading3)

# The hero card carries a cover-fit image with a rounded alpha mask.
hero = group()
hero.pos = (0, 40)
hero.effect("drop_shadow", color="#000000CC", offset= (16, 28), blur=28, opacity=0.75)
hero_body = rect(620, 430, radius=34, fill="#FFFFFF12", stroke="#FFFFFF38", stroke_width=2)
hero.add(hero_body)
photo = image("examples/assets/stripes.png", width=600, height=410, fit="cover")
hero.add(photo)
hero_label = label("COVER FIT / GLASS / SHADOW", 28, "#FFFFFF", 0, -250)
hero.add(hero_label)
s3.add(hero)

pop(hero, 8.3, 0.8)
hero.key("pos.y", 8.3, 90)
hero.key("pos.y", 9.2, 40, ease="cubic_out")

# Two glass slabs with their own shadows and a live glow.
for i in range(2):
    side = group()
    side.pos = (-560 + i * 1120, 40)
    side.effect("drop_shadow", color="#000000B3", offset= (10, 18), blur=20, opacity=0.65)
    slab = rect(380, 300, radius=26, fill="#FFFFFF0E", stroke="#FFFFFF2E", stroke_width=2)
    side.add(slab)
    dot = circle(34, fill= [BLUE, MINT][i])
    dot.pos = (0, -70)
    side.add(dot)
    name = label(["COMPOSITE", "MATTE"][i], 30, INK, 0, 20)
    side.add(name)
    note = label(["shadow + opacity", "mask + blend"][i], 28, CAPTION, 0, 70)
    side.add(note)
    pop(side, 8.5 + i * 0.12, 0.7)
    s3.add(side)

# ---- scene 4: masks and kinetic type (12-16 s) -----------------------------

s4 = scene(12, 15.7)

plate = group()
plate.pos = (0, -40)
plate.id("pro_plate")
plate_grad = rect(1280, 300, radius=30, fill=linear_gradient(start= (-640, 0), end= (640, 0), stops= [(0, "#5A7CFF"), (0.5, "#33F2E6"), (1, "#8A5AFF")]))
plate.add(plate_grad)
# Cap-height optical centring: the text origin is the baseline, so the ink box
# from `text_bounds` tells us how far to push the baseline down to centre the
# capitals (not the descender line) in the card.
reveal_ink = text_bounds("REVEAL", 190, font="Inter", weight=700, tracking=0.02, align="center")
plate_word = text("REVEAL", font="Inter", size=190, weight=700, color="#05070D", align="center", tracking=0.02)
plate_word.pos = (0, 0 - (reveal_ink[1] + reveal_ink[3]) / 2)
plate.add(plate_word)

wipe = rect(1500, 400, radius=40, fill="#FFFFFF")
wipe.id("pro_wipe")
# The mask source sits in composition space and is never drawn, exactly as in
# masks.motion; putting it inside the scene group would make its coverage
# relative to a group that is itself fading.
wipe.pos = (60, 500)
wipe.key("pos.x", 12.2, 60)
wipe.key("pos.x", 13.5, 960, ease=bezier(0.7, 0, 0.25, 1))
wipe.key("pos.x", 14.8, 1860, ease="cubic_in_out")
plate.mask(wipe, mode="alpha")
s4.add(plate)

kinetic = text("KINETIC", font="Inter", size=110, weight=600, color=INK, align="center", tracking=0.12)
kinetic.pos = (0, 300)
kinetic.animate_chars("opacity", 0, 1, 13, 0.06, 0.35, order="reverse", ease="quad_out")
kinetic.animate_chars("offset", (0, 34), (0, 0), 13, 0.06, 0.4, order="reverse", ease="quad_out")
s4.add(kinetic)

caption4 = label("alpha mask - per-character animation", 30, CAPTION, 0, 410)
fade_in(caption4, 13.2, 0.5)
s4.add(caption4)

# ---- scene 5: motion (16-20 s) ---------------------------------------------

s5 = scene(16, 19.7)

heading5 = label("Timing is design", 84, INK, 0, -370)
rise(heading5, 0, -370, 16.1, 40, 0.6)
s5.add(heading5)

track = rect(1300, 10, radius=5, fill=DIM)
track.pos = (0, -90)
s5.add(track)

chip = rect(90, 90, radius=22, fill=CORAL)
chip.pos = (-560, -90)
chip.key("pos.x", 16.4, -560)
chip.key("pos.x", 17.5, 560, ease=bezier(0.7, 0, 0.2, 1))
chip.key("scale", 16.4, 1)
chip.key("scale", 17, 1.35, ease="quad_out")
chip.key("scale", 17.5, 1, ease="quad_in")
s5.add(chip)

# Motion blur is visible on this fast bar, and the named ease makes the
# acceleration readable even before the blur.
fast = rect(46, 140, radius=14, fill=CYAN)
fast.pos = (-560, 110)
fast.key("pos.x", 17.9, -560, ease="linear")
fast.key("pos.x", 18.25, 560, ease="linear")
s5.add(fast)

bars5 = []
for i in range(8):
    bar = rect(70, 20, radius=8, fill=PALETTE[i % 7])
    bar.pos = (-490 + i * 140, 300)
    bars5 = bars5 + [bar]
    s5.add(bar)
stagger(bars5, "height", [(20, 160)], 16.8, 0.08, 0.6, ease="back_out")

badge = circle(26, fill=AMBER)
badge.pos = (0, 390)
badge.wiggle("pos.x", 11, 2.4, 30, 16.6, 19.4)
s5.add(badge)

caption5 = label("bezier / stagger / wiggle / motion blur", 30, CAPTION, 0, 470)
fade_in(caption5, 16.9, 0.5)
s5.add(caption5)

# ---- scene 6: outro (20-24 s) ----------------------------------------------

s6 = scene(20, 23.3)

mark2 = path([(-170, 140), (-170, -140), (0, 20), (170, -140), (170, 140)], closed=False, fill=None, stroke=INK, stroke_width=14, cap="round", join="round")
mark2.pos = (0, -60)
mark2.key("trim_end", 20.2, 0)
mark2.key("trim_end", 21.4, 1, ease=bezier(0.65, 0, 0.25, 1))
s6.add(mark2)

outro = text("MADE WITH MOTIONER", font="Inter", size=64, weight=700, color=INK, align="center", tracking=0.06)
outro.pos = (0, 150)
outro.animate_chars("opacity", 0, 1, 20.8, 0.04, 0.3, ease="quad_out")
s6.add(outro)

tagline = label("one program - every frame deterministic", 30, CAPTION, 0, 220)
fade_in(tagline, 21.4, 0.5)
s6.add(tagline)

footer = label("1920 x 1080 / 60 fps / MDF", 28, CAPTION, 0, 430)
fade_in(footer, 21.8, 0.5)
s6.add(footer)
